# ---------------------------------------------------------------------------
# Copy this file to ".env" ONLY if you prefer a local file over the Windows
# environment variable. Placeholder values only - never commit real secrets.
#
# If GROQ_API_KEY is already set as a Windows environment variable you do NOT
# need this file at all: the application reads the variable directly and only
# falls back to .env when the variable is absent.
# ---------------------------------------------------------------------------

# Your Groq API key from https://console.groq.com/keys
# Check whether it exists (without printing it) with:
#   PowerShell:  if ($env:GROQ_API_KEY) { "set" } else { "missing" }
GROQ_API_KEY=

# Optional: override the speech-to-text model.
# Verified available models: whisper-large-v3-turbo (default), whisper-large-v3
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo

# Optional: absolute paths to the executables if they are not on PATH.
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
# FFPROBE_PATH=C:\ffmpeg\bin\ffprobe.exe